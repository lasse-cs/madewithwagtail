---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Pagination from '../../components/Pagination.astro';
import SiteCard from '../../components/SiteCard.astro';
import { withBase } from '../../helpers.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const allSites = await getCollection('sites');
  const allDevelopers = await getCollection('developers');

  const developerMap = new Map(allDevelopers.map((d) => [d.id, d]));

  const sortedSites = allSites.sort(
    (a, b) =>
      new Date(b.data.latest_revision_created_at).getTime() -
      new Date(a.data.latest_revision_created_at).getTime(),
  );

  return paginate(sortedSites, {
    pageSize: 12,
    props: { developers: Object.fromEntries(developerMap) },
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

interface DeveloperEntry {
  id: string;
  data: {
    title: string;
  };
}

interface PaginatedSite {
  id: string;
  data: {
    title: string;
    site_url: string | null;
  };
}

const developerMap = new Map(
  Object.entries(
    (page.data.length > 0 ? Astro.props.developers : {}) as Record<string, DeveloperEntry>,
  ),
);

// Page 1 duplicates the homepage: same cards, self-canonical to '/'.
const isFirstPage = page.currentPage === 1;
const firstSite = page.start + 1;
const lastSite = page.end + 1;
---

<BaseLayout
  title={isFirstPage ? undefined : `Page ${page.currentPage}`}
  description={`A showcase of sites and applications made with Wagtail CMS — sites ${firstSite}–${lastSite} of ${page.total}.`}
  canonical={isFirstPage ? '/' : undefined}
>
  <div class="content-width">
    <div class="banner">
      <h1>Made with Wagtail</h1>
      <div class="intro">
        <p>
          A showcase of sites and applications made with{' '}
          <a href="https://wagtail.org">Wagtail CMS</a>.
        </p>
      </div>
    </div>

    <div class="grid grid-stack site-listing">
      {page.data.map((site: PaginatedSite, index: number) => {
        const dev = developerMap.get(site.id.split('/')[0]);
        return (
          <SiteCard
            title={site.data.title}
            url={withBase(`/developers/${site.id}/`)}
            developerName={dev?.data.title ?? 'A Wagtail developer'}
            developerUrl={withBase(dev ? `/developers/${dev.id}/` : '/developers/')}
            id={site.id}
            siteUrl={site.data.site_url}
            eager={index < 3}
          />
        );
      })}
    </div>

    <Pagination page={page} />
  </div>
</BaseLayout>

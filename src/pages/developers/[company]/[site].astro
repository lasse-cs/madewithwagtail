---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Icon from '../../../components/Icon.astro';
import { facetSlug, markdownExcerpt, withBase } from '../../../helpers.ts';
import { lookupImage } from '../../../images.ts';
import { formatLastUpdated } from '../../../lastmod.mjs';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const sites = await getCollection('sites');
  return sites.map((site) => ({
    // Route params derive from the entry ID ('<company>/<site>'), i.e.
    // the folder structure — no slug frontmatter needed.
    params: {
      company: site.id.split('/')[0],
      site: site.id.split('/').at(-1),
    },
    props: { siteEntry: site },
  }));
}) satisfies GetStaticPaths;

const { siteEntry } = Astro.props;
const { Content } = await render(siteEntry);
// The screenshot is colocated at
// src/content/developers/<company>/<site>/<site>.fill-1200x996.webp
// when the site has one.
const screenshot = lookupImage(siteEntry.id, '.fill-1200x996.webp');

const developers = await getCollection('developers');
const devMap = new Map(developers.map((d) => [d.id, d]));

const parentDev = devMap.get(siteEntry.id.split('/')[0]);
const coopDev = siteEntry.data.in_cooperation_with_slug
  ? devMap.get(siteEntry.data.in_cooperation_with_slug)
  : null;

const lastUpdated = formatLastUpdated(siteEntry.data.latest_revision_created_at);

// Social preview uses the site's screenshot, when there is one.
const ogImage = screenshot
  ? {
      src: screenshot.src,
      width: screenshot.width,
      height: screenshot.height,
      type: `image/${screenshot.format}`,
      alt: `Screenshot of the ${siteEntry.data.title} website`,
    }
  : undefined;
---

<BaseLayout
  title={siteEntry.data.title}
  description={markdownExcerpt(siteEntry.body)}
  ogImage={ogImage}
>
  <div class="site-content content-width">
    <Breadcrumbs
      ancestors={[
        { title: 'Developers', url: withBase('/developers/') },
        ...(parentDev
          ? [{ title: parentDev.data.title, url: withBase(`/developers/${parentDev.id}/`) }]
          : []),
      ]}
    />

    <div class="grid-float">
      <div class="two-thirds--medium">
        <div class="card">
          <div class="project-big-image">
            {screenshot && (
              <img
                src={screenshot.src}
                alt={siteEntry.data.title}
                title={siteEntry.data.title}
                class="img--responsive"
              />
            )}
          </div>
        </div>
      </div>
      <div class="one-third--medium">
        {/* The site title is the page's primary heading; styled via .h2 to
            keep the established visual hierarchy. */}
        <h1 class="h2">{siteEntry.data.title}</h1>
        <p class="project-author project-author--block">
          Made by{' '}
          {parentDev ? (
            <a href={withBase(`/developers/${parentDev.id}/`)}>{parentDev.data.title}</a>
          ) : (
            'A Wagtail developer'
          )}
          {coopDev && (
            <span class="project-featuring">
              &mdash; in cooperation with{' '}
              <a href={withBase(`/developers/${coopDev.id}/`)}>{coopDev.data.title}</a>
            </span>
          )}
        </p>

        <div class="text">
          <Content />
        </div>

        {siteEntry.data.site_url && (
          <a
            href={siteEntry.data.site_url}
            title={siteEntry.data.title}
            class="btn -small icon-text"
          >
            <Icon name="visit" class="i--small u-middle" />
            <span>Visit site</span>
          </a>
        )}

        <hr>

        {(siteEntry.data.sector.length > 0 ||
          siteEntry.data.site_type.length > 0 ||
          siteEntry.data.capability.length > 0) && (
          <>
            <hr>
            <div class="btn-group">
              {siteEntry.data.sector.map((value: string) => (
                <a href={withBase(`/sites/sector/${facetSlug(value)}/`)} class="btn -tag">
                  {value}
                </a>
              ))}
              {siteEntry.data.site_type.map((value: string) => (
                <a href={withBase(`/sites/type/${facetSlug(value)}/`)} class="btn -tag">
                  {value}
                </a>
              ))}
              {siteEntry.data.capability.map((value: string) => (
                <a href={withBase(`/sites/capability/${facetSlug(value)}/`)} class="btn -tag">
                  {value}
                </a>
              ))}
            </div>
          </>
        )}
        {siteEntry.data.technologies.length > 0 && (
          <p class="project-technologies">
            Built with {siteEntry.data.technologies.join(', ')}
          </p>
        )}
        {lastUpdated && <p class="last-updated">Last updated: {lastUpdated}</p>}
      </div>
    </div>
  </div>
</BaseLayout>

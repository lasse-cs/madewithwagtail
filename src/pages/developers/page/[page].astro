---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import DeveloperCard from '../../../components/DeveloperCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { withBase } from '../../../helpers.ts';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const allDevelopers = await getCollection('developers');
  const allSites = await getCollection('sites');

  // Count owned sites plus collaborations (in_cooperation_with_slug).
  const siteCounts = new Map<string, number>();
  const bump = (slug: string) => siteCounts.set(slug, (siteCounts.get(slug) ?? 0) + 1);
  for (const site of allSites) {
    bump(site.id.split('/')[0]);
    if (site.data.in_cooperation_with_slug) bump(site.data.in_cooperation_with_slug);
  }

  const developersWithCounts = allDevelopers.map((dev) => ({
    ...dev,
    sitesCount: siteCounts.get(dev.id) ?? 0,
  }));

  const sortedDevelopers = developersWithCounts.sort((a, b) => {
    const countDiff = b.sitesCount - a.sitesCount;
    if (countDiff !== 0) return countDiff;
    return (
      new Date(b.data.latest_revision_created_at).getTime() -
      new Date(a.data.latest_revision_created_at).getTime()
    );
  });

  return paginate(sortedDevelopers, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

// Page 1 duplicates the developer index: same cards, self-canonical to
// '/developers/'.
const isFirstPage = page.currentPage === 1;

interface PaginatedDeveloper {
  id: string;
  data: {
    title: string;
    location: string | null;
  };
  sitesCount?: number;
}
---

<BaseLayout
  title={isFirstPage ? 'Developers' : `Developers - Page ${page.currentPage}`}
  canonical={isFirstPage ? '/developers/' : undefined}
>
  <div class="content-width">
    <div class="banner">
      <h1>Developers</h1>
    </div>
    <div class="grid-float">
      {page.data.map((dev: PaginatedDeveloper) => (
        <DeveloperCard
          title={dev.data.title}
          url={withBase(`/developers/${dev.id}/`)}
          id={dev.id}
          location={dev.data.location}
          sitesCount={dev.sitesCount ?? 0}
        />
      ))}
    </div>

    <Pagination page={page} />
  </div>
</BaseLayout>

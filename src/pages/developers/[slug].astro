---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import SiteCard from '../../components/SiteCard.astro';
import { absoluteUrl, markdownExcerpt, withBase } from '../../helpers.ts';
import { lookupImage } from '../../images.ts';
import { formatLastUpdated, latestDate } from '../../lastmod.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbListNode, organizationNode } from '../../schema.ts';

export const getStaticPaths = (async () => {
  const developers = await getCollection('developers');
  return developers.map((d) => ({
    // A developer's slug is their directory name, i.e. the entry ID.
    params: { slug: d.id },
    props: {
      developer: d,
      // The logo is colocated at
      // src/content/developers/<id>/<id>.max-120x120.webp when the
      // developer has one.
      logo: lookupImage(d.id, '.max-120x120.webp'),
    },
  }));
}) satisfies GetStaticPaths;

const { developer, logo } = Astro.props;

// A developer's sites: those in their own directory, plus sites they
// contributed to via in_cooperation_with_slug.
const devSites = (await getCollection('sites')).filter((site) => {
  const company = site.id.split('/')[0];
  const isOwner = company === developer.id;
  const isCooperator = site.data.in_cooperation_with_slug === developer.id && !isOwner;
  return isOwner || isCooperator;
});

const allDevelopers = await getCollection('developers');
const devMap = new Map(allDevelopers.map((d) => [d.id, d]));

const { Content } = await render(developer);

// The profile's "Last updated" date is the most recent site on it.
const lastUpdated = formatLastUpdated(
  latestDate(devSites.map((site) => site.data.latest_revision_created_at)),
);

function getCooperator(cooperatorSlug: string) {
  return devMap.get(cooperatorSlug);
}

// Structured data: the developer as an Organization, plus the breadcrumb
// trail (Home > Developers > <Developer>).
const profilePath = `/developers/${developer.id}/`;
const jsonLd = [
  organizationNode({
    path: profilePath,
    name: developer.data.title,
    companyUrl: developer.data.company_url,
    description: markdownExcerpt(developer.body),
    logo: logo?.src ?? null,
    location: developer.data.location,
    lat: developer.data.lat,
    lon: developer.data.lon,
    twitterHandler: developer.data.twitter_handler,
    githubUser: developer.data.github_user,
  }),
  breadcrumbListNode([
    { name: 'Developers', url: absoluteUrl('/developers/') },
    { name: developer.data.title, url: absoluteUrl(profilePath) },
  ]),
];
---

<BaseLayout
  title={developer.data.title}
  description={markdownExcerpt(developer.body)}
  jsonLd={jsonLd}
>
  <div class="site-content content-width">
    <Breadcrumbs ancestors={[{ title: 'Developers', url: withBase('/developers/') }]} />

    <div class="company grid-float">
      {logo && (
        <div>
          <div class="company__logo">
            <img
              src={logo.src}
              alt={developer.data.title}
              title={developer.data.title}
              width={logo.width}
              height={logo.height}
            />
          </div>
        </div>
      )}
      <div class="company__details">
        <h1 class="company__title">{developer.data.title}</h1>
        <ul class="company__info">
          {developer.data.location && (
            <li class="company__info__item">
              <span class="icon-text">
                <Icon name="location" />
                {developer.data.location}
              </span>
            </li>
          )}
          {developer.data.company_url && (
            <li class="company__info__item">
              <a class="icon-text" href={developer.data.company_url}>
                <Icon name="link" class="i--hover" />
                {developer.data.company_url}
              </a>
            </li>
          )}
          {developer.data.twitter_handler && (
            <li class="company__info__item">
              <a
                class="icon-text"
                href={`https://twitter.com/${developer.data.twitter_handler.replace(/^@+/, '')}`}
              >
                <Icon name="twitter" class="i--hover" />
                {developer.data.twitter_handler}
              </a>
            </li>
          )}
          {developer.data.github_user && (
            <li class="company__info__item">
              <a class="icon-text" href={`https://github.com/${developer.data.github_user}`}>
                <Icon name="github" class="i--hover" />
                {developer.data.github_user}
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>

    {developer.body && (
      <div class="company__description">
        <Content />
      </div>
    )}

    <div class="company__sites">
      <div class="grid grid-stack site-listing">
        {devSites.map((site) => {
          const isOwn = site.id.split('/')[0] === developer.id;
          const coopSlug = isOwn
            ? site.data.in_cooperation_with_slug
            : site.id.split('/')[0];
          const coop = coopSlug ? getCooperator(coopSlug) : null;
          return (
            <SiteCard
              title={site.data.title}
              url={withBase(`/developers/${site.id}/`)}
              developerName={isOwn ? developer.data.title : (coop?.data.title ?? 'A Wagtail developer')}
              developerUrl={withBase(
                isOwn ? `/developers/${developer.id}/` : (coop ? `/developers/${coop.id}/` : '/developers/'),
              )}
              id={site.id}
              siteUrl={site.data.site_url}
              inCooperationWith={isOwn
                ? (coop?.data.title ?? null)
                : (developer.data.title)
              }
              inCooperationWithUrl={isOwn
                ? (coop ? withBase(`/developers/${coop.id}/`) : null)
                : withBase(`/developers/${developer.id}/`)
              }
            />
          );
        })}
      </div>
    </div>

    {lastUpdated && <p class="last-updated">Last updated: {lastUpdated}</p>}
  </div>
</BaseLayout>

---
import { withBase } from '../helpers.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <div class="content-width">
    <div class="banner">
      <h1>Page not found</h1>
      <div class="intro">
        <p>The page you're looking for doesn't exist or has moved.</p>
      </div>
    </div>

    <div class="intro">
      <p>Try one of these instead:</p>
      <ul class="list-none">
        <li>
          <p><a class="btn -small" href={withBase('/')}>Browse all sites</a></p>
        </li>
        <li>
          <p><a class="btn -small" href={withBase('/developers/')}>Find a Wagtail developer</a></p>
        </li>
        <li>
          <p><a class="btn -small" href={withBase('/submit-your-site/')}>Submit your site</a></p>
        </li>
      </ul>
    </div>
  </div>
</BaseLayout>

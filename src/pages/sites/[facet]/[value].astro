---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import SiteCard from '../../../components/SiteCard.astro';
import { facetSlug, withBase } from '../../../helpers.ts';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const FACETS = { sector: 'sector', type: 'site_type', capability: 'capability' } as const;
  const allSites = await getCollection('sites');
  const paths: {
    params: { facet: string; value: string };
    props: { display: string; facetLabel: string };
  }[] = [];
  for (const [facet, field] of Object.entries(FACETS) as [string, string][]) {
    const facetLabel =
      facet === 'type' ? 'Site type' : facet === 'capability' ? 'Capability' : 'Sector';
    // slug -> display, first spelling wins
    const values = new Map<string, string>();
    for (const site of allSites) {
      for (const value of site.data[field as 'sector' | 'site_type' | 'capability'] as string[]) {
        const slug = facetSlug(value);
        if (!values.has(slug)) values.set(slug, value);
      }
    }
    for (const [value, display] of values) {
      paths.push({ params: { facet, value }, props: { display, facetLabel } });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const { facet, value } = Astro.params;
const { display, facetLabel } = Astro.props;

const FACETS = { sector: 'sector', type: 'site_type', capability: 'capability' } as const;
const field = FACETS[facet as keyof typeof FACETS] as 'sector' | 'site_type' | 'capability';

const allSites = await getCollection('sites');
const allDevelopers = await getCollection('developers');
const devMap = new Map(allDevelopers.map((d) => [d.id, d]));

const filteredSites = allSites
  .filter((site) => (site.data[field] as string[]).some((v) => facetSlug(v) === value))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const displayValue = display.charAt(0).toUpperCase() + display.slice(1);

function getCooperator(cooperatorSlug: string) {
  return devMap.get(cooperatorSlug);
}
---

<BaseLayout title={`${displayValue} sites`}>
  <div class="site-content content-width">
    <div class="banner">
      <h1>{displayValue} sites</h1>
      <div class="intro">
        <p>{facetLabel}: &ldquo;{display}&rdquo;</p>
        <a href={withBase('/')}>Show all sites</a>
      </div>
    </div>

    <div class="grid grid-stack site-listing">
      {filteredSites.map((site, index) => {
        const dev = devMap.get(site.id.split('/')[0]);
        return (
          <SiteCard
            title={site.data.title}
            url={withBase(`/developers/${site.id}/`)}
            developerName={dev?.data.title ?? 'A Wagtail developer'}
            developerUrl={withBase(dev ? `/developers/${dev.id}/` : '/developers/')}
            id={site.id}
            siteUrl={site.data.site_url}
            eager={index < 3}
            inCooperationWith={site.data.in_cooperation_with_slug
              ? getCooperator(site.data.in_cooperation_with_slug)?.data.title ?? null
              : null
            }
            inCooperationWithUrl={
              site.data.in_cooperation_with_slug
                ? withBase(
                    getCooperator(site.data.in_cooperation_with_slug)
                      ? `/developers/${site.data.in_cooperation_with_slug}/`
                      : '/developers/',
                  )
              : null
            }
          />
        );
      })}
    </div>
  </div>
</BaseLayout>

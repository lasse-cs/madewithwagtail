---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SiteCard from '../../../components/SiteCard.astro';
import { FACETS, type FacetKey, facetLabel, facetValues } from '../../../facets.ts';
import { absoluteUrl, facetSlug, withBase } from '../../../helpers.ts';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { breadcrumbListNode, collectionPageNode } from '../../../schema.ts';

export const getStaticPaths = (async () => {
  const allSites = await getCollection('sites');
  const paths: {
    params: { facet: string; value: string };
    props: { display: string; facetLabel: string; count: number };
  }[] = [];
  for (const facet of Object.keys(FACETS) as FacetKey[]) {
    for (const facetValue of facetValues(facet, allSites)) {
      paths.push({
        params: { facet, value: facetValue.slug },
        props: {
          display: facetValue.display,
          facetLabel: facetLabel(facet),
          count: facetValue.count,
        },
      });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const { facet, value } = Astro.params;
const { display, facetLabel: label } = Astro.props;

const allSites = await getCollection('sites');
const allDevelopers = await getCollection('developers');
const devMap = new Map(allDevelopers.map((d) => [d.id, d]));

// Hand-written intro copy for this facet, when there is one
// (src/content/facets/<facet>/<value>.md).
const introEntry = (await getCollection('facets')).find(
  (entry) => entry.id === `${facet}/${value}`,
);
const Intro = introEntry ? (await render(introEntry)).Content : null;

const filteredSites = allSites
  .filter((site) =>
    (site.data[FACETS[facet as FacetKey]] as string[]).some((v) => facetSlug(v) === value),
  )
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const displayValue = display.charAt(0).toUpperCase() + display.slice(1);

// Meta description: counts computed from the content collections.
const developerCount = new Set(filteredSites.map((site) => site.id.split('/')[0])).size;
const description =
  facet === 'type'
    ? `${filteredSites.length} Wagtail ${display.toLowerCase()} sites, built by ${developerCount} developers and agencies — browse the showcase on Made with Wagtail.`
    : facet === 'capability'
      ? `${filteredSites.length} Wagtail sites featuring ${display.toLowerCase()}, built by ${developerCount} developers and agencies — browse the showcase on Made with Wagtail.`
      : `${filteredSites.length} Wagtail sites in the ${displayValue} ${label.toLowerCase()}, built by ${developerCount} developers and agencies — browse the showcase on Made with Wagtail.`;

// Structured data: the filtered listing plus its breadcrumb trail
// (Home > Sites > <Value>).
const facetPath = `/sites/${facet}/${value}/`;
const jsonLd = [
  collectionPageNode({
    path: facetPath,
    name: `${displayValue} sites`,
    items: filteredSites.map((site) => ({
      name: site.data.title,
      url: absoluteUrl(`/developers/${site.id}/`),
    })),
  }),
  breadcrumbListNode([
    { name: 'Sites', url: absoluteUrl('/sites/') },
    { name: `${displayValue} sites`, url: absoluteUrl(facetPath) },
  ]),
];

function getCooperator(cooperatorSlug: string) {
  return devMap.get(cooperatorSlug);
}
---

<BaseLayout title={`${displayValue} sites`} description={description} jsonLd={jsonLd}>
  <div class="site-content content-width">
    <Breadcrumbs ancestors={[{ title: 'Sites', url: withBase('/sites/') }]} />

    <div class="banner">
      <h1>{displayValue} sites</h1>
      <div class="intro">
        <p>{label}: &ldquo;{display}&rdquo;</p>
        <p>
          <a href={withBase('/sites/')}>All sectors, types, and capabilities</a>
          &middot;{' '}
          <a href={withBase('/')}>Show all sites</a>
        </p>
      </div>
    </div>

    {Intro && (
      <div class="text nice-line-length vertical-top">
        <Intro />
      </div>
    )}

    <div class="grid grid-stack site-listing">
      {filteredSites.map((site, index) => {
        const dev = devMap.get(site.id.split('/')[0]);
        return (
          <SiteCard
            title={site.data.title}
            url={withBase(`/developers/${site.id}/`)}
            developerName={dev?.data.title ?? 'A Wagtail developer'}
            developerUrl={withBase(dev ? `/developers/${dev.id}/` : '/developers/')}
            id={site.id}
            siteUrl={site.data.site_url}
            eager={index < 3}
            inCooperationWith={site.data.in_cooperation_with_slug
              ? getCooperator(site.data.in_cooperation_with_slug)?.data.title ?? null
              : null
            }
            inCooperationWithUrl={
              site.data.in_cooperation_with_slug
                ? withBase(
                    getCooperator(site.data.in_cooperation_with_slug)
                      ? `/developers/${site.data.in_cooperation_with_slug}/`
                      : '/developers/',
                  )
              : null
            }
          />
        );
      })}
    </div>
  </div>
</BaseLayout>

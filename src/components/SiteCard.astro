---
import { lookupImage } from '../images.ts';
import Icon from './Icon.astro';

interface Props {
  // Site entry ID '<company>/<site>': the screenshot is colocated at
  // src/content/developers/<company>/<site>/<site>.fill-1200x996.webp
  // when the site has one.
  id: string;
  title: string;
  url: string;
  developerName: string;
  developerUrl: string;
  siteUrl: string | null;
  inCooperationWith?: string | null;
  inCooperationWithUrl?: string | null;
  // Load the screenshot eagerly, for cards above the fold on listings.
  eager?: boolean;
}

const {
  id,
  title,
  url,
  developerName,
  developerUrl,
  siteUrl,
  inCooperationWith,
  inCooperationWithUrl,
  eager,
} = Astro.props;
const screenshot = lookupImage(id, '.fill-1200x996.webp');
---

<div class="one-half--medium one-third--large">
  <div class="card card--link">
    <a href={url} class="project-image">
      {screenshot && (
        <img
          src={screenshot.src}
          alt={title}
          width={screenshot.width}
          height={screenshot.height}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      )}
    </a>
    <div class="project__links">
      <a class="project__info" href={url}>
        <span class="u-sr-only">Project info</span>
        <Icon name="info" class="i--hover" />
      </a>
      {siteUrl && (
        <a class="project__visit" href={siteUrl}>
          <span class="u-sr-only">Project link</span>
          <Icon name="visit" class="i--hover" />
        </a>
      )}
    </div>
  </div>
  <h4 class="project-title">{title}</h4>
  <p class="project-author">
    <a href={developerUrl}>{developerName}</a>
    {inCooperationWith && (
      <span class="project-featuring">
        &mdash; in cooperation with{' '}
        <a href={inCooperationWithUrl ?? '#'}>{inCooperationWith}</a>
      </span>
    )}
  </p>
</div>

{
  "name": "astro-mww",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "npm run lint:format && npm run lint:css",
    "lint:format": "biome check .",
    "lint:css": "stylelint --report-needless-disables --report-unscoped-disables 'src/**/*.{css,scss}'",
    "format": "npm run format:code && npm run format:css",
    "format:code": "biome check --write .",
    "format:css": "prettier --write 'src/**/*.{css,scss}'"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.12",
    "@wagtail/stylelint-config-wagtail": "^2.0.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "sass": "^1.101.0",
    "stylelint": "^17.14.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
  }
}
